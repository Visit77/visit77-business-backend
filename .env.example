DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# SQLite is used only when DB_ENGINE is not postgres.
# Docker Compose expects PostgreSQL and Redis to already be running on the server/host.
DB_ENGINE=postgres
DB_NAME=booking_engine
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORE_BASE_URL=http://127.0.0.1:8000
CORE_SERVICE_TOKEN=
# Must match Core's BOOKING_ENGINE_CORE_SERVICE_KEY.
CORE_SERVICE_KEY=
# For Core's current HS256 tokens, set this to the Core JWT signing key.
# Prefer RS256 + CORE_JWT_VERIFYING_KEY when Core moves to asymmetric signing.
CORE_JWT_SIGNING_KEY=
CORE_JWT_VERIFYING_KEY=
CORE_JWT_ALGORITHM=HS256
CORE_JWT_AUDIENCE=
CORE_JWT_ISSUER=
BOOKING_ADMIN_API_KEY=replace-with-a-long-random-service-secret
BOOKING_REQUIRE_BUSINESS_SCOPE=false
BOOKING_HOLD_MINUTES=15
BOOKING_INVENTORY_WINDOW_DAYS=365
DEMO_PAYMENT_ENABLED=true

# Private S3 storage for guest identity documents. Returned URLs are signed and expire.
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_CUSTOM_DOMAIN=media.visit77.com
AWS_CLOUDFRONT_KEY_ID=
# PEM private key; multiline values may be supplied using literal \\n characters.
AWS_CLOUDFRONT_KEY=
# Optional for S3-compatible providers; leave empty for AWS S3.
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=900
TIME_ZONE=Asia/Yangon
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1
WEB_PORT=8080
DAPHNE_PORT=8081
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=4
DJANGO_LOG_LEVEL=INFO
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5
