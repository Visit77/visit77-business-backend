DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# SQLite is used only when DB_ENGINE is not postgres.
# Docker Compose expects PostgreSQL and Redis to already be running on the server/host.
DB_ENGINE=postgres
DB_NAME=booking_engine
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORE_BASE_URL=http://127.0.0.1:8000
CORE_SERVICE_TOKEN=
# Must match Core's BOOKING_ENGINE_CORE_SERVICE_KEY.
CORE_SERVICE_KEY=
# For Core's current HS256 tokens, set this to the Core JWT signing key.
# Prefer RS256 + CORE_JWT_VERIFYING_KEY when Core moves to asymmetric signing.
CORE_JWT_SIGNING_KEY=
CORE_JWT_VERIFYING_KEY=
CORE_JWT_ALGORITHM=HS256
CORE_JWT_AUDIENCE=
CORE_JWT_ISSUER=
BOOKING_ADMIN_API_KEY=replace-with-a-long-random-service-secret
BOOKING_REQUIRE_BUSINESS_SCOPE=false
BOOKING_HOLD_MINUTES=15
DEMO_PAYMENT_ENABLED=true
TIME_ZONE=Asia/Yangon
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1
WEB_PORT=8080
DAPHNE_PORT=8081
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=4
