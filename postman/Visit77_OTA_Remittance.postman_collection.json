{
  "info": {
    "name": "Visit77 OTA Remittance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "booking_base_url", "value": "https://api.business.visit77.com/api/v1"},
    {"key": "booking_admin_key", "value": ""},
    {"key": "business_id", "value": "9480"},
    {"key": "superadmin_token", "value": ""},
    {"key": "admin_actor_id", "value": ""},
    {"key": "hotel_actor_id", "value": ""},
    {"key": "hotel_id", "value": ""},
    {"key": "remittance_id", "value": ""},
    {"key": "remittance_reference", "value": ""}
  ],
  "item": [
    {
      "name": "Hotel",
      "item": [
        {
          "name": "Create hotel payee",
          "request": {
            "method": "POST",
            "header": [
              {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
              {"key": "X-Booking-Business-ID", "value": "{{business_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Hotel Payee One\",\n  \"passcode\": \"1234\"\n}"},
            "url": "{{booking_base_url}}/admin/remittance-checkers/"
          }
        },
        {
          "name": "List hotel payees",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittance-checkers/"}
        },
        {
          "name": "Remove hotel payee",
          "request": {"method": "DELETE", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittance-checkers/{{hotel_actor_id}}/"}
        },
        {
          "name": "OTA revenue All / Available / Held / Refunded",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/?status=all"}
        },
        {
          "name": "Current week available revenue",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/available/"}
        },
        {
          "name": "Current held funds",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/held-funds/?offset=1&limit=20"}
        },
        {
          "name": "Refund history",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/refunds/?offset=1&limit=20"}
        },
        {
          "name": "Completed week remittance history",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittances/?search={{remittance_reference}}&offset=1&limit=20"}
        },
        {
          "name": "Remittance detail with booking IDs",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittances/{{remittance_id}}/"}
        },
        {
          "name": "Download remittance statement PDF",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittances/{{remittance_id}}/pdf/"}
        },
        {
          "name": "Confirm received",
          "request": {"method": "POST", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"},
            {"key": "Content-Type", "value": "application/json"}
          ], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{hotel_actor_id}}\",\n  \"passcode\": \"1234\"\n}"}, "url": "{{booking_base_url}}/admin/remittances/{{remittance_id}}/receive/"}
        }
      ]
    },
    {
        "name": "Visit77 Superadmin",
      "item": [
        {
          "name": "Create payer",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Finance Admin\",\n  \"passcode\": \"6543\",\n  \"access_rights\": [\"checker\", \"payer\"]\n}"}, "url": "{{booking_base_url}}/superadmin/remittance-actors/"}
        },
        {
          "name": "List admin actors",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittance-actors/"}
        },
        {
          "name": "Remove admin actor",
          "request": {"method": "DELETE", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittance-actors/{{admin_actor_id}}/"}
        },
        {
          "name": "Set dynamic commission rate",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"package\": \"ota\",\n  \"rate\": \"5.00\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittance-commission-rates/"}
        },
        {
          "name": "Get hotel payout option",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/hotels/{{hotel_id}}/remittance-payout-option/"}
        },
        {
          "name": "Set hotel payout option",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"payout_option\": \"twice_weekly\"\n}"}, "url": "{{booking_base_url}}/superadmin/hotels/{{hotel_id}}/remittance-payout-option/"}
        },
        {
          "name": "List remittances",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittances/?payout_option=all&action_filter=need_to_action&offset=1&limit=20"}
        },
        {
          "name": "Remittance history",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittances/history/?business_id={{business_id}}&search={{remittance_reference}}&offset=1&limit=20"}
        },
        {
          "name": "Download remittance statement PDF",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/pdf/"}
        },
        {
          "name": "Check remittance",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{admin_actor_id}}\",\n  \"passcode\": \"6543\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/check/"}
        },
        {
          "name": "Pay remittance",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "body": {"mode": "formdata", "formdata": [
            {"key": "actor_id", "value": "{{admin_actor_id}}", "type": "text"},
            {"key": "passcode", "value": "6543", "type": "text"},
            {"key": "adjustment_operator", "value": "+", "description": "Use + to add or - to deduct", "type": "text"},
            {"key": "adjustment_amount", "value": "0", "description": "Positive amount only", "type": "text"},
            {"key": "adjustment_note", "value": "", "type": "text"},
            {"key": "payment_reference", "value": "BANK-TXN-001", "type": "text"},
            {"key": "receipt", "type": "file", "src": []}
          ]}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/pay/"}
        },
        {
          "name": "Reopen receipt confirmation",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{admin_actor_id}}\",\n  \"passcode\": \"6543\",\n  \"reason\": \"Hotel must confirm receipt\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/reopen-receipt/"}
        },
        {
          "name": "Reset remittance to pending for retest",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{admin_actor_id}}\",\n  \"passcode\": \"6543\",\n  \"reason\": \"Retest need-to-action flow\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/reset-to-pending/"}
        }
      ]
    }
  ]
}
