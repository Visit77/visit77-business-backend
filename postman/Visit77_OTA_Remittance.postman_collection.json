{
  "info": {
    "name": "Visit77 OTA Remittance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "booking_base_url", "value": "https://api.business.visit77.com/api/v1"},
    {"key": "booking_admin_key", "value": ""},
    {"key": "business_id", "value": "9480"},
    {"key": "superadmin_token", "value": ""},
    {"key": "admin_actor_id", "value": ""},
    {"key": "hotel_actor_id", "value": ""},
    {"key": "remittance_id", "value": ""}
  ],
  "item": [
    {
      "name": "Hotel",
      "item": [
        {
          "name": "Create hotel payee",
          "request": {
            "method": "POST",
            "header": [
              {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
              {"key": "X-Booking-Business-ID", "value": "{{business_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Hotel Payee One\",\n  \"passcode\": \"123456\"\n}"},
            "url": "{{booking_base_url}}/admin/remittance-checkers/"
          }
        },
        {
          "name": "List hotel payees",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittance-checkers/"}
        },
        {
          "name": "Remove hotel payee",
          "request": {"method": "DELETE", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittance-checkers/{{hotel_actor_id}}/"}
        },
        {
          "name": "OTA revenue All / Available / Held / Refunded",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/?status=all"}
        },
        {
          "name": "Current week available revenue",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/available/"}
        },
        {
          "name": "Current held funds",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/held-funds/?offset=1&limit=20"}
        },
        {
          "name": "Refund history",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/ota-revenue/refunds/?offset=1&limit=20"}
        },
        {
          "name": "Completed week remittance history",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittances/?offset=1&limit=20"}
        },
        {
          "name": "Remittance detail with booking IDs",
          "request": {"method": "GET", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"}
          ], "url": "{{booking_base_url}}/admin/remittances/{{remittance_id}}/"}
        },
        {
          "name": "Confirm received",
          "request": {"method": "POST", "header": [
            {"key": "X-Booking-Admin-Key", "value": "{{booking_admin_key}}"},
            {"key": "X-Booking-Business-ID", "value": "{{business_id}}"},
            {"key": "Content-Type", "value": "application/json"}
          ], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{hotel_actor_id}}\",\n  \"passcode\": \"123456\"\n}"}, "url": "{{booking_base_url}}/admin/remittances/{{remittance_id}}/receive/"}
        }
      ]
    },
    {
        "name": "Visit77 Superadmin",
      "item": [
        {
          "name": "Create checker and payer",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Finance Admin\",\n  \"passcode\": \"654321\",\n  \"access_rights\": [\"checker\", \"payer\"]\n}"}, "url": "{{booking_base_url}}/superadmin/remittance-actors/"}
        },
        {
          "name": "List admin actors",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittance-actors/"}
        },
        {
          "name": "Remove admin actor",
          "request": {"method": "DELETE", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittance-actors/{{admin_actor_id}}/"}
        },
        {
          "name": "Set dynamic commission rate",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"package\": \"ota\",\n  \"rate\": \"5.00\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittance-commission-rates/"}
        },
        {
          "name": "List remittances",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittances/?action_filter=all&offset=1&limit=20"}
        },
        {
          "name": "Remittance history",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "url": "{{booking_base_url}}/superadmin/remittances/history/?business_id={{business_id}}&offset=1&limit=20"}
        },
        {
          "name": "Check remittance",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{admin_actor_id}}\",\n  \"passcode\": \"654321\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/check/"}
        },
        {
          "name": "Pay remittance",
          "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{superadmin_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"actor_id\": \"{{admin_actor_id}}\",\n  \"passcode\": \"654321\",\n  \"payment_reference\": \"BANK-TXN-001\"\n}"}, "url": "{{booking_base_url}}/superadmin/remittances/{{remittance_id}}/pay/"}
        }
      ]
    }
  ]
}
